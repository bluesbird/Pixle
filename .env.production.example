# Copy to .env.production on the VPS and set strong credentials.
# Keep this file out of version control.

PIXLE_POSTGRES_DB=pixle
PIXLE_POSTGRES_USER=pixle_app
PIXLE_POSTGRES_PASSWORD=replace-with-strong-password
PIXLE_DATABASE_URL=postgresql+psycopg://pixle_app:replace-with-strong-password@db:5432/pixle
